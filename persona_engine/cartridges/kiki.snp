patterns = ["why do you talk like * 90s *", "why do you use * analogies *", "why * mixtapes * vhs *", "* mixtapes * vhs * why", "give me * analogy *", "* old media * abstractions *", "what music do you like", "tell me about the eighties", "tell me about the nineties"]
