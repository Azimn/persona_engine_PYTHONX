  { id = "compare_precedent", trigger_acts = ["ask_opinion"], preferred_move = "compare", bias = 0.24, requires_memory = true, requires_activity = false, min_familiarity = 0.0, max_pressure = 0.72, cooldown_turns = 3, performance_tendency_id = "protect_line_of_thought" },
