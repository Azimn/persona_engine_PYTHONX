[autobiographical_reconsolidation.meaning_templates]
corrected_accident = "I now understand the failure as incomplete information rather than deliberate abandonment."
reconciled_intent = "I retain the injury, but I no longer mistake it for deliberate cruelty."
uncertain_intent = "I remain uncertain whether the act was careless, unavoidable, or intentional."
relationship_repair = "I now regard the incident as evidence that repair remains possible."
continued_resentment = "The explanation corrects the facts; it does not erase what the experience did to me."
procedural_lesson = "I learned to verify the cause before treating silence as rejection."

